# Copy to .env and fill in what you need. Empty = use the default shown in the comment.
# Never commit .env: it holds your API keys.

# ---- Server ----
# HTTP port (default 3000)
PORT=
# production = HTTPS-only redirects, HSTS, Twilio signature checks on, LOG_LEVEL info (default: development)
NODE_ENV=
# Public HTTPS URL Twilio can reach, e.g. https://abcd-1234.ngrok-free.app (needed for live calls)
PUBLIC_URL=
# debug | info | warn | error. debug prints transcripts: never in production (default debug locally, info in production)
LOG_LEVEL=
# Password for the /setup page (required in production; any user name works)
SETUP_PASSWORD=

# ---- Country ----
# Profile from config/countries/: US, UK, CA, AU, JP, SG, DE (default US)
COUNTRY=

# ---- Protected person (can also be set on the /setup page) ----
# Name used in family alerts, e.g. Mom (default Mom)
PROTECTED_PERSON_NAME=
# The protected person's real phone number; Wessuwan rings it after the announcement
PROTECTED_PHONE_NUMBER=
# Comma-separated trusted contacts: connected straight through, never processed
TRUSTED_NUMBERS=
# true = consent was collected outside the setup page (otherwise record it on /setup before protection starts)
CONSENT_RECORDED=

# ---- Twilio (calls, SMS, WhatsApp) ----
# Account SID from the Twilio Console (starts with AC)
TWILIO_ACCOUNT_SID=
# Auth token from the Twilio Console (also used to validate webhook signatures)
TWILIO_AUTH_TOKEN=
# Your Twilio phone number: callers dial it, and SMS alerts are sent from it
TWILIO_PHONE_NUMBER=
# WhatsApp sender for ALERT_CHANNEL=whatsapp, e.g. whatsapp:+14155238886 (Twilio sandbox)
TWILIO_WHATSAPP_FROM=
# true/false: reject webhooks without a valid X-Twilio-Signature (default true in production, false locally)
TWILIO_VALIDATE_SIGNATURE=

# ---- Speech-to-text ----
# google or deepgram (default google)
STT_PROVIDER=
# Fallback language when auto-detection isn't available, BCP-47 (default: the country's language, e.g. en-US)
STT_LANGUAGE=
# Path to a Google service account JSON (Speech-to-Text, and optional Text-to-Speech for warning audio)
GOOGLE_APPLICATION_CREDENTIALS=
# Deepgram API key and model (default nova-3)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
# Deepgram: silence (ms) that ends a sentence and starts a check; ~500-700 is quick without splitting sentences (default 600).
# Google ends sentences with its own final results.
STT_ENDPOINTING_MS=

# ---- Scam detector: Jev (TypeSafe's decision model via Defapi) ----
# jev (default) or llm (the chat-model detector below)
DETECTOR=
# Defapi API key (defapi.org). Billed per input token only: a fraction of a cent per check (npm run test:detector prints the real cost)
JEV_API_KEY=
# Decisions API endpoint (default Defapi: https://api.defapi.org/api/v1/decisions). Point it at another Jev provider if needed, e.g. OpenRouter: https://openrouter.ai/api/alpha/decisions
JEV_URL=
# Pinned Jev version so thresholds stay tuned (default typesafe/jev-1.13). Never use ~typesafe/jev-latest
JEV_MODEL=
# Checks run at the end of each caller sentence (no fixed timer). Backup: if the caller talks this long (ms)
# without a final speech-to-text result, the partial text is checked (default 4000)
LONG_SPEECH_CHECK_MS=
# Warn when scam_likelihood (0-4) >= this AND confidence >= JEV_WARN_CONFIDENCE (defaults 3.5 / 0.7)
JEV_WARN_SCORE=
JEV_WARN_CONFIDENCE=
# Also warn when scam_likelihood >= this on two checks in a row (default 2.5)
JEV_HIGH_SCORE=
# A yes/no signal counts as detected at this probability (default 0.7)
JEV_SIGNAL_THRESHOLD=
# Request timeout in ms; a slow check is skipped, never waited on (default 3000)
JEV_TIMEOUT_MS=
# Transcript sent to Jev is cut to the most recent lines under this size; Jev is slower and less accurate over ~32 KB (default 24000)
MAX_TRANSCRIPT_BYTES=
# none or llm: after 3 Jev failures in a row, switch that call to the chat-model detector (default none)
JEV_FALLBACK=

# ---- Chat-model detector (DETECTOR=llm, or JEV_FALLBACK=llm) ----
# gemini or anthropic (default gemini). Free tiers may train on data: test data only!
LLM_PROVIDER=
# Google Gemini API key, and fast/precise models (default gemini-flash-lite-latest / gemini-flash-latest)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_PRECISE_MODEL=
# Older name for the fast model, used when GEMINI_FAST_MODEL is empty
GEMINI_MODEL=
# Anthropic API key, and fast/precise models (default claude-haiku-5-5 / claude-sonnet-5-5)
ANTHROPIC_API_KEY=
FAST_MODEL=
PRECISE_MODEL=
# Fast-model risk at which the precise model confirms the score (default 40)
CONFIRM_THRESHOLD=

# ---- Alerts ----
# sms or whatsapp (default sms)
ALERT_CHANNEL=
# Comma-separated family numbers that get the alert, e.g. +15550100133,+15550100144
FAMILY_PHONE_NUMBERS=
# Smoothed risk 0-100 at which the person is warned and family alerted (default 70)
RISK_THRESHOLD=
# Risk at which the call is hung up automatically, or off (default off)
AUTO_HANGUP_THRESHOLD=
# Optional Google TTS voice name for the English warning, e.g. en-US-Neural2-F (default: Google's default voice)
TTS_VOICE=
# true = only log Twilio actions (calls, SMS) instead of performing them (default false)
MOCK=

# ---- Privacy ----
# 32-byte key, base64 or 64 hex chars. Encrypts summaries and settings. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Days to keep encrypted scam summaries before automatic deletion (default 30)
SUMMARY_RETENTION_DAYS=

# ---- Public demo ----
# true = judge demo: no real SMS/calls, no STT, read-only settings, rate-limited Try it page (default false)
PUBLIC_DEMO=
# Detector checks allowed per IP per hour on the Try it page (default 150)
RATE_LIMIT_PER_HOUR=150
# Links shown on the homepage
GITHUB_URL=
PITCH_DECK_URL=

# ---- Guardian ----
# Household context for the detector and the intervention cap (default family.json)
FAMILY_FILE=
